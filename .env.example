# ==============================================================================
# CONFIGURACIÓN DEL PROVEEDOR LLM (openai | groq)
# ==============================================================================
LLM_PROVIDER=groq

# Clave y modelo para OpenAI (si usas LLM_PROVIDER=openai)
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-4o-mini

# Clave y modelo para Groq (si usas LLM_PROVIDER=groq, ultra rápido y económico)
GROQ_API_KEY=tu_groq_api_key_aqui
GROQ_MODEL=openai/gpt-oss-120b

# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR FASTAPI Y FRONTEND
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8008
FRONTEND_PORT=8505
BACKEND_URL=http://localhost:8008

